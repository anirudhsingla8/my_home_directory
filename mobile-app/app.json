{
  "expo": {
    "name": "mobile-app",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Home Inventory to access your photos.",
          "cameraPermission": "Allow Home Inventory to use your camera."
        }
      ]
    ]
  }
}
