# Server Port
PORT=3000

# Database Configuration (PostgreSQL URL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Authentication
# Replace with a strong, random string (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-here-at-least-32-chars"

# ----------------------------------------------------
# Storage Service Configuration
# ----------------------------------------------------
# Define which service to use for image uploads.
# Options: "firebase" | "cloudinary"
IMAGE_STORAGE_SERVICE="cloudinary"

# Optional: Define the folder name to store images in your selected bucket/cloud.
# Defaults to "items" if left blank.
IMAGE_STORAGE_FOLDER="inventory_images"

# --- Cloudinary Adapter ---
# Required if IMAGE_STORAGE_SERVICE="cloudinary"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- Firebase Adapter ---
# Required if IMAGE_STORAGE_SERVICE="firebase"
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "...", "client_id": "...", "auth_uri": "...", "token_uri": "...", "auth_provider_x509_cert_url": "...", "client_x509_cert_url": "...", "universe_domain": "googleapis.com"}'
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"

# ----------------------------------------------------
# Email Service Configuration
# ----------------------------------------------------
# Which provider to use for outgoing emails (forgot-password OTPs, etc.).
# Options: "gmail" | "nodemailer" | "resend" | "console" | "noop"
#   gmail      — sends via Gmail SMTP using Nodemailer. Easiest option — no
#                domain needed. Requires a Gmail App Password.
#   nodemailer — generic SMTP via Nodemailer (use SMTP_SERVICE or SMTP_HOST).
#   resend     — Resend API. Requires a verified sender domain.
#   console    — logs emails locally instead of sending them (good for dev).
#   noop       — silently drops emails (good for CI / tests).
EMAIL_PROVIDER="gmail"

# Sender address used for all outgoing emails. Format: 'Name <addr@example.com>'.
# For Gmail this must match (or be aliased to) SMTP_USER below.
EMAIL_FROM="Home Inventory <yourname@gmail.com>"

# --- Gmail / Nodemailer Adapter ---
# Required if EMAIL_PROVIDER="gmail" or "nodemailer".
# For Gmail:
#   1. Enable 2-Step Verification on your Google account.
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#      (it's 16 characters; spaces are ignored — paste with or without them).
#   3. Set SMTP_USER to your full Gmail address and SMTP_PASS to the App Password.
SMTP_USER="yourname@gmail.com"
SMTP_PASS="abcdefghijklmnop"

# Optional — only used when EMAIL_PROVIDER="nodemailer":
#   Either set SMTP_SERVICE to a known Nodemailer service (e.g. "outlook365",
#   "yahoo"), OR set the raw SMTP_HOST/SMTP_PORT/SMTP_SECURE values.
# SMTP_SERVICE="outlook365"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"            # 465 = implicit TLS, 587 = STARTTLS
# SMTP_SECURE="false"        # "true" for port 465, "false" for 587

# --- Resend Adapter ---
# Required if EMAIL_PROVIDER="resend"
# Get your key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# Public URL of the web frontend, used to build links inside emails.
APP_URL="http://localhost:5173"
